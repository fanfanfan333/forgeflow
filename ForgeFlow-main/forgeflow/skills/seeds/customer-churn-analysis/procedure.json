{
  "domain": "数据分析",
  "procedure": [
    {
      "purpose": "解析客户行为数据，抽取可用信号",
      "tool": "docs.parse",
      "input": ["text"],
      "output": ["sections"],
      "validation": "section_count > 0"
    },
    {
      "purpose": "依据信号计算流失概率",
      "tool": "analysis.score",
      "input": ["observations"],
      "output": ["score"],
      "validation": "score 在 [0,1]"
    },
    {
      "purpose": "生成挽留建议报告",
      "tool": "report.render",
      "input": ["intent"],
      "output": ["content"],
      "validation": "content 非空"
    }
  ]
}
