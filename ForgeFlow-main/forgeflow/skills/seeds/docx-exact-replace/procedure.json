{
  "domain": "文档编辑",
  "procedure": [
    {
      "purpose": "读取文档结构，确认待替换文本确实存在",
      "tool": "document.inspect",
      "input": ["document_paths"],
      "output": ["structure"],
      "validation": "structure 非空"
    },
    {
      "purpose": "对精确匹配的文本片段执行替换，仅改动命中处",
      "tool": "document.edit",
      "input": ["document_paths", "edits"],
      "output": ["artifact_ref"],
      "validation": "替换结果校验通过"
    },
    {
      "purpose": "校验替换结果并登记交付产物",
      "tool": "artifact.save",
      "input": ["artifact_ref"],
      "output": ["result_ref"],
      "validation": "result_ref 非空"
    }
  ]
}
