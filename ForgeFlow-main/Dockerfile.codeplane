FROM node:24-bookworm-slim AS node-runtime
FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends git gcc g++ tmux ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN git config --system --add safe.directory /workspace
RUN pip install --no-cache-dir openhands-sdk==1.49.6 openhands-tools==1.49.6 pytest
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers NODE_PATH=/usr/local/lib/node_modules
RUN npm install --global @playwright/test@1.61.1 \
    && playwright install --with-deps chromium \
    && chmod -R a+rX /opt/playwright-browsers
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENHANDS_SUPPRESS_BANNER=1
WORKDIR /workspace
USER 1000:1000
