# ============================================================
# ForgeFlow — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- LLM Provider ---
# One of: ollama | mock   (openai | anthropic were removed in INC16)
# `ollama` runs against a local Ollama daemon; `mock` returns deterministic
# offline responses — no key, no network.
LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) ---
# Install: pip install 'forgeflow[ollama]' and run an Ollama daemon.
# Models are slotted by capability:
#   OLLAMA_MODEL / OLLAMA_MODEL_STRONG → text + reasoning
#   OLLAMA_VISION_MODEL                → image description (independent slot,
#                                         so a text-only reasoning model can be
#                                         used without losing image handling)
# Use names your daemon actually serves (`ollama list`). A thinking model (e.g.
# qwen3:8b) runs fine with OLLAMA_THINK=false (think=false, the default) — the C1
# guard only skips a thinking model when thinking is explicitly turned ON.
# (Do not cite `llama3.1:8b` here — it is no longer present on the local box.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_STRONG=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# --- PostgreSQL (asyncpg DSN) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_URL=postgresql+asyncpg://forgeflow:forgeflow@localhost:5432/forgeflow

# --- PostgreSQL (psycopg3 DSN for LangGraph checkpointer + alembic) ---
# Keep the `+psycopg` driver suffix: Alembic builds its engine straight from this
# URL, and a bare `postgresql://` makes SQLAlchemy default to psycopg2 (which the
# image doesn't ship). The checkpointer strips the suffix before handing it to
# psycopg, so this form works for both.
POSTGRES_SYNC_URL=postgresql+psycopg://forgeflow:forgeflow@localhost:5432/forgeflow

# --- LangSmith (optional, but strongly recommended) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=forgeflow

# --- MCP Server ---
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: openssl rand -hex 32. Required — startup fails without it.
API_SECRET_KEY=change-me-in-production-use-secrets-manager

# --- Auth (dev / OSS preview) ---
# /auth/login is a demo path gated behind DEV_LOGIN_PASSWORD. Set
# DEV_LOGIN_ENABLED=false in production and front the API with an OIDC IdP.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_PASSWORD=change-me-locally-only

# Disable interactive docs in production.
DOCS_ENABLED=true

# Comma-separated CORS allowlist. Never set to "*".
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8501

# Number of trusted reverse-proxy hops in front of the API. 0 = ignore
# X-Forwarded-For and use the socket peer (recommended unless you control
# the proxy layer end-to-end).
TRUSTED_PROXY_COUNT=0

# --- Resilience ---
MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
BUDGET_LIMIT_USD=5.0

# --- Web Search (Tavily) ---
TAVILY_API_KEY=tvly-...

# --- Tracing provider (high-level switch) ---
# One of: langsmith | phoenix | langfuse | none
# Picking phoenix or langfuse enables OTel automatically with the right endpoint.
TRACING_PROVIDER=langsmith

# --- Langfuse (when TRACING_PROVIDER=langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OpenTelemetry (auto-configured by TRACING_PROVIDER; override below if needed) ---
# Install: pip install 'forgeflow[otel]'
OTEL_ENABLED=false
OTEL_SERVICE_NAME=forgeflow-api
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
# Comma-separated 'k=v' headers (used for vendor auth, e.g. Honeycomb / Datadog)
OTEL_EXPORTER_HEADERS=

# --- Slack (optional — for HITL approval notifications) ---
# Bot token: xoxb-...  Required scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#forgeflow
# Externally-reachable URL of this API — used in Slack approve/reject buttons
API_PUBLIC_URL=http://localhost:8000

# --- Streamlit Dashboard ---
API_URL=http://localhost:8000

# --- Docker (used by docker-compose.yml) ---
POSTGRES_PASSWORD=forgeflow

# ============================================================
# AgentFlow hub extensions (docs/sop/02-ARCHITECTURE.md §10.3)
# ============================================================

# Repository backend for the hub services. `memory` runs the full
# task→experience→skill loop with no PostgreSQL connection (offline demo).
STORAGE_BACKEND=postgres

# Embeddings for experiences/memory are always the deterministic local vector
# (no external key needed) — semantic search works in an offline/air-gapped run.
EMBEDDING_DIMENSION=1536

# Closed-loop jump ③ (Skill Candidate Compiler) thresholds.
SKILL_CANDIDATE_MIN_EXPERIENCES=3
SKILL_CANDIDATE_SIMILARITY_THRESHOLD=0.85
SKILL_FEATURED_LIMIT=4

# Security hub.
TENANT_ISOLATION_LEVEL=row
DEFAULT_TENANT_ID=default
DLP_ENABLED=true

# Validation / replan loop.
MAX_REPLAN_ATTEMPTS=2

# ============================================================
# AgentFlow Increment 2 (INC2) — docs/sop/05-ARCHITECTURE-INC2.md
# ============================================================

# --- A1 Cost optimization ---
COST_CURRENCY=CNY
COST_WARN_RATIO=0.8
COST_EXCEED_ACTIONS=swap_model,trim_context,pause_noncritical
COST_SAVINGS_BASELINE_MULTIPLIER=1.0

# --- A2 SLO tiers (frozen values, architecture §7.2) ---
SLO_CRITICAL_AVAILABILITY=0.995
SLO_CRITICAL_P95_MS=1500
SLO_IMPORTANT_AVAILABILITY=0.990
SLO_IMPORTANT_P95_MS=2000
SLO_EDGE_AVAILABILITY=0.970
SLO_EDGE_P95_MS=5000

# --- A5 Context builder ---
CONTEXT_BUDGET_TOKENS=2000
CONTEXT_PER_ITEM_RATIO=0.4

# --- B4 dedup / conflict resolution ---
DEDUP_MERGE_THRESHOLD=0.95

# --- C1 multi-model fallback routing ---
# JSON array or comma-separated string. Outside production the deterministic
# `mock` provider is appended automatically; in production `mock` is NEVER a
# fallback and an exhausted chain raises (fail closed).
MODEL_FALLBACK_CHAIN=["ollama"]
# Thinking control. Keep FALSE: with OLLAMA_THINK=true a thinking model spends
# its whole num_predict budget on the hidden trace and returns "" — the C1 guard
# skips a thinking model in exactly that case. With OLLAMA_THINK=false
# (think=false) a thinking model answers normally. Production flags true as fatal.
OLLAMA_THINK=false

# --- Agent runtime path (INC4 §A / INC17 / INC22 W2) ---
# auto | llm | react | deterministic. `auto` resolves from the configured
# provider (source of truth: forgeflow/runtime/orchestrator.py::resolve_agent_runtime_mode()):
#   * auto + a real provider (LLM_PROVIDER not in ("", "mock")) ⇒ `react` — the
#     Qwen-driven multi-round tool-calling closed loop (the mainline experience).
#   * auto + LLM_PROVIDER in ("", "mock")                        ⇒ `deterministic`
#     — the offline profile keeps the original platform graph byte-for-byte.
# `llm` / `react` / `deterministic` pin the path regardless of provider.
AGENT_RUNTIME_MODE=auto

# --- Proxy / NO_PROXY (INC22 W2) ---
# If this host has HTTP_PROXY / HTTPS_PROXY set, you MUST also set:
#     NO_PROXY=127.0.0.1,localhost,::1
# Otherwise langchain's httpx client routes even a call to the LOCAL Ollama
# daemon (e.g. http://127.0.0.1:11434) through the proxy ⇒ 502 ⇒ the runtime
# SILENTLY degrades to the deterministic platform graph. That degradation is
# invisible from the surface — status=completed / outcome=success / errors=[]
# all look perfectly normal; the truth is only in the run detail's `llm.degraded`.
# (Uncomment the line below on such a host; it is NOT a default to change.)
# NO_PROXY=127.0.0.1,localhost,::1

# --- Code execution plane (INC25 / INC26) ---
# The code plane runs a code task inside an isolated workspace copy using the
# OpenHands SDK. That SDK lives in its OWN virtualenv — NOT the ForgeFlow venv
# (whose openai==3.19.0 conflicts with the SDK), so CODEPLANE_INTERPRETER must
# point at the 'openhands' venv's python interpreter (absolute path).
# Leave it EMPTY and the plane HONESTLY degrades to `engine_unavailable`
# (reason: 「未配置代码执行面解释器…」) — that is by design, NOT a bug.
#
# ⚠️ The ONLY variable that configures the interpreter is CODEPLANE_INTERPRETER
#    (the UPPER-cased `Settings.codeplane_interpreter` field). Writing
#    `FORGEFLOW_CODEPLANE_PYTHON` **in this .env file does NOT work**: that name
#    is only a *process-environment* fallback read by `os.environ.get(...)` inside
#    `codeplane/engine.py::SubprocessOpenHandsEngine`, and pydantic-settings reads
#    .env into the Settings object WITHOUT injecting it into os.environ — so the
#    alias is never seen and the engine silently stays `engine_unavailable`
#    (with no error). Always use CODEPLANE_INTERPRETER here.
#
# Two interpreters, two DIFFERENT jobs — do not point them at the same venv:
#   * CODEPLANE_INTERPRETER   — starts codeplane/runner/run_code_task.py and must
#                               own the OpenHands SDK (the dedicated 'openhands'
#                               venv; it has no pytest and that is fine).
#   * CODEPLANE_TEST_COMMAND  — runs the isolated workspace's tests; its FIRST
#                               token must be an ABSOLUTE interpreter path that
#                               really has `pytest` installed (a bare `python` on
#                               Windows is often the WindowsApps stub that
#                               silently exits 1, turning a real fix into a fake
#                               test failure). This is a DIFFERENT venv (e.g. the
#                               ForgeFlow 'agentflow' venv) — keep them separate.
# CODEPLANE_ENABLED=true
# CODEPLANE_INTERPRETER=C:\Users\me\.venv-openhands\Scripts\python.exe
# CODEPLANE_TEST_COMMAND=C:\Users\me\.venv-agentflow\Scripts\python.exe -m pytest -q
#   ^ absolute path required (see above); the interpreter must actually have pytest.
#     ⚠️ Leave this value UNQUOTED. python-dotenv mis-handles the alternatives:
#        `"<path>" -m pytest -q` (quote + unquoted text) prints "could not parse
#        statement" and silently DROPS the line (⇒ bare `python` fallback), while
#        `"<path> -m pytest -q"` (fully double-quoted) escape-processes `\b`/`\a`
#        and CORRUPTS the Windows path. Unquoted keeps the path intact.
# CODEPLANE_MODEL=ollama_chat/qwen3:8b          # empty ⇒ derived from the provider
# CODEPLANE_BASE_URL=http://127.0.0.1:11434     # empty ⇒ OLLAMA_BASE_URL
# CODEPLANE_MAX_ROUNDS=30
# CODEPLANE_TIMEOUT_SECONDS=180
# CODEPLANE_WORKSPACE_TTL_HOURS=24
# CODEPLANE_REASONING_EFFORT=none
#   ^ keep `none`: the SDK default `high` is translated by LiteLLM's ollama_chat
#     provider into Ollama think=true, so the first round returns an EMPTY
#     response (no content, no tool call) and the agent never acts.
# CODEPLANE_NUM_CTX=32768                        # context window for the local model
# CODEPLANE_TEMPERATURE=0
#   ^ default 0: the local qwen3:8b is UNSTABLE at its native default temperature
#     (empirically 2/3 of runs); its failure shape is a terminal soft-timeout retry
#     loop that never finishes (~201s / 15 retries). Keep it at 0 for a deterministic
#     edit run after run. A missing value is treated as 0.0 (never the model default).

# --- A4 skill marketplace ---
# Default false (tenant-only). shared=true requires an explicit approve:skills.
MARKETPLACE_CROSS_TENANT=false

# --- C4 multimodal attachments (5 MB) ---
MULTIMODAL_MAX_BYTES=5242880

# --- B1 DLP configurable rules (JSON file override; empty = built-in defaults) ---
DLP_RULES_FILE=

